{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-copilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Daily cleanup (90-day tracker retention, expired sign-ins, 30-day radar jobs), and the job radar every 30 minutes.
  "triggers": { "crons": ["17 3 * * *", "*/30 * * * *"] },
  // Static files: logo, favicon, social image, screenshots (served before the Worker).
  "assets": { "directory": "./public" },
  // Custom domain (zone must be in this Cloudflare account). The workers.dev URL keeps working too.
  "routes": [{ "pattern": "jobs.smudgee.xyz", "custom_domain": true }],
  // Keep request URLs as localhost in `wrangler dev` (otherwise they're rewritten to the custom domain).
  "dev": { "host": "localhost:8787" },
  "vars": {
    "APP_NAME": "JobSeeker",
    // Public base URL, e.g. https://jobs.example.com. Empty = this Worker's own URL (fine for *.workers.dev).
    "PUBLIC_URL": "",
    // Comma-separated Chrome extension IDs allowed to sign in (empty = any, fine for development)
    "EXTENSION_IDS": "",
    // Chrome Web Store listing URL, once published (the home page shows "coming soon" until then).
    "CHROME_STORE_URL": "",
    // Job radar (src/radar). Secrets: TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, RADAR_OWNER_EMAIL (who may edit the watchlist).
    // Sized for the Workers Free plan (50 subrequests, ~10 ms CPU per run); raise on Workers Paid.
    "RADAR_BATCH": "42",
    "RADAR_SUBREQUESTS": "48",
    "RADAR_PARSE_BYTES": "800000",
    "RADAR_ALERT_MIN_SCORE": "70",
    "RADAR_QUIET_HOURS": "23-7",
    "RADAR_TIME_ZONE": "Asia/Kolkata"
  },
  // OAuth grants/tokens for the Claude/ChatGPT connector (required by workers-oauth-provider).
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "job_copilot", "migrations_dir": "migrations" }
  ],
  // One "room" per user: live extension connection + captured forms.
  "durable_objects": {
    "bindings": [{ "name": "USER_ROOM", "class_name": "UserRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserRoom"] }]
}
