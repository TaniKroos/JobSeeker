{
  "name": "extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "build:store": "wxt build --mode store",
    "zip:store": "wxt zip --mode store",
    "assets": "node scripts/make-assets.mjs",
    "build:edge": "wxt build -b edge",
    "zip:edge": "wxt zip -b edge --mode store"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  }
}
